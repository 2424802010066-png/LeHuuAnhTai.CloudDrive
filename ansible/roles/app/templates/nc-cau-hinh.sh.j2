#!/usr/bin/env bash
# {{ ansible_managed }}
# Cấu hình Nextcloud bằng occ — chạy lại bao nhiêu lần cũng ra cùng một kết quả.
# Lê Hữu Anh Tài - {{ mssv }}
set -euo pipefail
occ() { docker exec -u www-data nextcloud php occ "$@"; }

echo "== Chờ Nextcloud cài đặt xong (lần đầu mất 1-3 phút)"
for i in $(seq 1 120); do
  if occ status --output=json 2>/dev/null | grep -q '"installed":true'; then break; fi
  sleep 5
done
occ status

echo "== Tên miền tin cậy + proxy tin cậy (nginx -> Nextcloud qua cổng Docker)"
i=0
for d in {{ cloud_host }} {{ vps.app.service }} {{ inventory_hostname }}.{{ tailnet_suffix }} localhost; do
  occ config:system:set trusted_domains $i --value="$d"; i=$((i+1))
done
occ config:system:set trusted_proxies 0 --value="{{ nc_docker_gateway }}"
occ config:system:set forwarded_for_headers 0 --value="HTTP_X_FORWARDED_FOR"
occ config:system:set overwrite.cli.url --value="https://{{ cloud_host }}"

echo "== Chỉ cho phép thao tác QUẢN TRỊ khi kết nối từ VPN Tailscale"
occ config:system:set allowed_admin_ranges 0 --value="{{ vpn_cidr }}"
occ config:system:set allowed_admin_ranges 1 --value="{{ vpn_cidr6 }}"

echo "== Ngôn ngữ, vùng, múi giờ, nhật ký"
occ config:system:set default_language --value="vi"
occ config:system:set default_locale --value="vi_VN"
occ config:system:set default_phone_region --value="VN"
occ config:system:set logtimezone --value="{{ tz }}"
occ config:system:set loglevel --type=integer --value=2
occ config:system:set log_rotate_size --type=integer --value=104857600
occ config:system:set maintenance_window_start --type=integer --value=19   # 19h UTC = 02h giờ VN

echo "== Bảo mật"
occ config:system:set auth.bruteforce.protection.enabled --type=boolean --value=true
occ config:system:set htaccess.RewriteBase --value="/"
occ maintenance:update:htaccess
occ app:enable twofactor_totp
occ twofactorauth:enforce --on --group admin          # admin BẮT BUỘC xác thực 2 lớp (TOTP)
occ app:disable firstrunwizard || true

echo "== Tác vụ nền chạy bằng cron (container nextcloud-cron)"
occ background:cron

echo "== Hạn mức mặc định + chính sách chia sẻ"
occ config:app:set files default_quota --value="{{ nc_default_quota }}"
occ config:app:set core shareapi_default_expire_date --value="yes"
occ config:app:set core shareapi_expire_after_n_days --value="30"
occ config:app:set core shareapi_allow_public_upload --value="yes"

echo "== Nhóm người dùng"
occ group:add sinhvien --display-name "Sinh viên" 2>/dev/null || true
occ group:add khach --display-name "Khách (dùng thử)" 2>/dev/null || true

echo "== Giao diện (theming) — có MSSV để ảnh minh chứng luôn thấy MSSV"
occ theming:config name "{{ nc_brand_name }}"
occ theming:config slogan "{{ nc_brand_slogan }}"
occ theming:config url "https://{{ cloud_host }}"
occ theming:config primary_color "#0B5CAD"

echo "== Bảo dưỡng CSDL"
occ db:add-missing-indices
occ db:add-missing-columns
occ db:add-missing-primary-keys
occ maintenance:repair --include-expensive >/dev/null
echo "== XONG"
