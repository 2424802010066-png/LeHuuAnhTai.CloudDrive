# {{ ansible_managed }}
# vps-mon — Gatus. network_mode: host để ufw kiểm soát cổng {{ gatus_port }}.
name: gatus
services:
  gatus:
    image: {{ gatus_image }}
    container_name: gatus
    network_mode: host
    restart: unless-stopped
    env_file: .env
    environment:
      GATUS_CONFIG_PATH: /config/config.yaml
    cap_add: [NET_RAW]          # cần cho kiểm tra ICMP (ping)
    volumes:
      - ./config:/config:ro
      - ./data:/data
